{
  "description": "agent-orchestrator hooks: PostToolUse Agent|Task soft verify-reminder (non-blocking nudge), SessionEnd journal, SessionStart version-check, PreToolUse model-tier gate (Agent|Task) scout/explorer read-only gate (Bash), scout write gate (Write|Edit|MultiEdit|NotebookEdit: scout briefing files only, no secret values; Read|Grep: no secret paths for scout, explorer and planner) security-reviewer default-deny gate (Bash allowlist; Read|Grep: no secret paths) and loop-guard (all tools: blocks tight status-polling / TaskStop churn, warns then blocks subagents past ~150 tool calls or 4h). Per-hook rationale lives in each script's header comment.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/verify-reminder.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-journal.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/version-check.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/model-tier-gate.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/model-tier-gate.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scout-readonly-gate.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scout-readonly-gate.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scout-write-gate.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scout-write-gate.py\""
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/security-reviewer-gate.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/security-reviewer-gate.py\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/loop-guard.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/loop-guard.py\""
          }
        ]
      }
    ]
  }
}
