{
  "description": "agent-orchestrator hooks: PostToolUse Agent|Task soft verify-reminder (non-blocking nudge), SessionEnd journal, SessionStart version-check, PreToolUse model-tier gate (Agent|Task) and scout read-only gate (Bash). Per-hook rationale lives in each script's header comment.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/verify-reminder.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-journal.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/version-check.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/model-tier-gate.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/model-tier-gate.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scout-readonly-gate.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scout-readonly-gate.py\""
          }
        ]
      }
    ]
  }
}
